# -------------------------------
# INTERFACES (PHYSICAL & LOGICAL)
# -------------------------------

# Summary of all interfaces (status, speed, access VLAN)
# NOTE: VLAN column is misleading for trunks
show interface status

# Interface descriptions (what/where connected)
show interfaces description

# Detailed interface information (errors, counters, speed, duplex)
# Think: ethtool + ip -s link
show interface ethernet <value>

# Interface error and packet counters
show interface ethernet <value> counters

# Optical / copper transceiver details (TX/RX power, vendor)
show interface ethernet <value> transceiver details

# Which interfaces belong to which port-channel?
show port-channel summary
show etherchannel summary   # Catalyst

# Port-channel interface details
show interface port-channel <value>


# -------------------------------
# NEIGHBORS / DISCOVERY
# -------------------------------

# List all LLDP-detected neighbors (vendor neutral)
# Think: CDP but standards-based
show lldp neighbors

# LLDP details for a specific interface
show lldp neighbors interface ethernet <value>


# -------------------------------
# LAYER 2 / MAC ADDRESSING
# -------------------------------

# Display MAC address table (learned devices)
# NOTE: STATIC often means authenticated (MAB/802.1X), not manually configured
show mac address-table

# MAC addresses learned on a specific interface
show mac address-table interface ethernet <value>

# MAC addresses learned in a specific VLAN
show mac address-table vlan <value>


# -------------------------------
# VLANS
# -------------------------------

# List VLANs, status, and member ports
show vlan brief

# Detailed VLAN information
show vlan id <value>

# Ports assigned to a VLAN
show vlan id <value> port


# -------------------------------
# PORT-CHANNELS / LACP
# -------------------------------

# Port-channel summary (members, status)
# (SU) = up, (P) = properly bundled
show port-channel summary
show etherchannel summary

# Detailed port-channel information
show port-channel <value>

# LACP status for a specific interface
show lacp interface ethernet <value>


# -------------------------------
# SPANNING TREE
# -------------------------------

# Spanning Tree status for all VLANs
show spanning-tree

# Spanning Tree details for a specific interface
show spanning-tree interface ethernet <value> detail

# Root bridge information
show spanning-tree root


# -------------------------------
# LAYER 3 / IP
# -------------------------------

# IP interface status summary
# Includes SVIs and mgmt interface
show ip interface brief

# Routing table (default VRF)
# Think: ip route
show ip route

# ARP table
show ip arp


# -------------------------------
# MANAGEMENT VRF (CATALYST)
# -------------------------------

# Management IP and interface state
show ip interface brief vrf Mgmt-vrf

# Management routing table (VERY IMPORTANT for TACACS/ISE)
show ip route vrf Mgmt-vrf

# Static routes (default gateway, etc.)
show run | include ^ip route


# -------------------------------
# SYSTEM / HEALTH
# -------------------------------

# Software version and uptime
# Think: uname -a + OS version
show version

# Hardware inventory (PSUs, fans, modules)
show inventory

# CPU and memory usage
show system resources

# Environmental status (fans, temps, power)
show environment

# Recent system logs
show logging


# -------------------------------
# AUTHENTICATION / AAA (NEW)
# -------------------------------

# Show AAA configuration and authentication order
# Order matters (TACACS first, local only if TACACS unavailable)
show running-config | section aaa

# TACACS / RADIUS server reachability
# If servers are UP, local auth will NOT be used
show aaa servers

# Show all authenticated endpoints (MAB / 802.1X)
show authentication sessions

# Detailed authentication state for a specific port
# This is the SOURCE OF TRUTH for MAB vs sticky-mac
show authentication sessions interface ethernet <value> details

# Force reauthentication on a port
# Think: restarting a service / pod
clear authentication sessions interface ethernet <value>


# -------------------------------
# PORT SECURITY (LEGACY / CLEANUP)
# -------------------------------

# Port-security status (should be DISABLED when using MAB)
show port-security interface ethernet <value>

# Clear lingering sticky MACs
clear port-security sticky interface ethernet <value>


# -------------------------------
# TROUBLESHOOTING / OPERATIONS
# -------------------------------

# Last interface state change
show interface ethernet <value> | include last

# Clear interface counters (use cautiously)
clear counters interface ethernet <value>

# Verify enabled features (Nexus only)
show feature


# -------------------------------
# CONFIG SHORTCUTS / NOTES
# -------------------------------

# Access port baseline
switchport mode access
switchport access vlan <value>
spanning-tree portfast

# MAB baseline (what replaces sticky-mac)
authentication host-mode multi-auth
authentication port-control auto
mab

# Trunk baseline
switchport mode trunk
switchport trunk native vlan <unused-vlan>
switchport trunk allowed vlan <list>

# Shortcut (FYI)
# Access + portfast + bpduguard
# Usually NOT used on MAB/ISE ports
switchport host



# -------------------------------
# Palo Alto Firewall 
# -------------------------------

show system info | match sw-version
# Shows the currently running PAN-OS version.

show jobs all
# Shows active jobs such as software installs, content updates, and commits.

request system software info
# Lists PAN-OS versions available on the firewall and whether they are downloaded.

debug swm status
# Shows the boot partitions and which PAN-OS version is active, staged, or revertable.

show system disk-space
# Displays filesystem utilization and available storage.

show interface all
# Verifies interface status after an upgrade.

show advanced-routing route
# Displays the routing table when Advanced Routing Mode is enabled.

show high-availability state
# Checks HA status.

delete software version <version>
# Removes an old PAN-OS software image from the repository to free space.

request system software check
# Refreshes the available software list from Palo Alto update servers.

######## System Health

show system info
# Displays model, serial number, PAN-OS version, uptime, and management info.

show system resources
# Displays CPU, memory, and process utilization.

show system disk-space
# Displays filesystem utilization and available storage.

show clock
# Displays the current system time.

show jobs all
# Shows active and completed system jobs.

show jobs processed
# Shows recently completed jobs.


############ Software and Upgrade

request system software info
# Lists available and downloaded PAN-OS versions.

request system software check
# Refreshes available software versions from update servers.

debug swm status
# Shows active, revertable, and staged PAN-OS partitions.

show system info | match sw-version
# Displays the currently running PAN-OS version.

############ Interfaces

show interface all
# Displays status of all interfaces.

show interface ethernet1/1
# Displays detailed status for a specific interface.

show interface management
# Displays management interface status and IP information.

show counter interface
# Displays interface packet counters and errors.

######### ARP and Neighbors

show arp all
# Displays ARP table entries.

show neighbor all
# Displays discovered L2 neighbors.

show mac all
# Displays learned MAC addresses.

########### Sessions

show session info
# Displays firewall session statistics.

show session all
# Displays active sessions.

show session id <id>
# Displays details of a specific session.

clear session all
# Clears all sessions (use carefully).

############# Policies 

test security-policy-match
# Tests which security rule traffic matches.

show running security-policy
# Displays active security policies.